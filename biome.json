{
	"$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error"
			},
			"complexity": {
				"useLiteralKeys": "off"
			},
			"style": {
				"noNonNullAssertion": "error",
				"useImportType": "error",
				"useConst": "error"
			},
			"suspicious": {
				"noExplicitAny": "error"
			}
		}
	},
	"files": {
		"includes": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts", "!node_modules", "!dist", "!coverage"]
	}
}
